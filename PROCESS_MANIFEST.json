{
  "name": "assistente-financeiro-hermes",
  "version": "0.3.2",
  "repository": "https://github.com/jcarlosamorim/assistente-financeiro-hermes",
  "raw_base": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main",
  "student_prompt": "Vamos seguir este processo: https://github.com/jcarlosamorim/assistente-financeiro-hermes",
  "attachment_policy": {
    "process_files": "never_ask_student_to_attach_files_that_exist_in_this_repository",
    "student_data": "ask_only_for_personal_financial_data_not_present_in_public_repo",
    "fallback": "if_a_repo_file_cannot_be_fetched_ask_for_that_single_file_content_only"
  },
  "state_control": {
    "machine": "PROCESS.yaml",
    "checkpoint_schema": "CHECKPOINT_SCHEMA.json",
    "checkpoint_file": "finance_assistant_progress.json",
    "rule": "read checkpoint before every action and update after every state change"
  },
  "bootstrap_order": [
    {
      "id": "bootstrap",
      "path": "WEB_BOOTSTRAP.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/WEB_BOOTSTRAP.md",
      "purpose": "Rules for following the process from the repository URL without attachments."
    },
    {
      "id": "manifest",
      "path": "PROCESS_MANIFEST.json",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/PROCESS_MANIFEST.json",
      "purpose": "Index of files the agent must fetch from the repository."
    },
    {
      "id": "process_yaml",
      "path": "PROCESS.yaml",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/PROCESS.yaml",
      "purpose": "State machine, gates and resume rules."
    },
    {
      "id": "checkpoint_schema",
      "path": "CHECKPOINT_SCHEMA.json",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/CHECKPOINT_SCHEMA.json",
      "purpose": "Schema for local progress checkpoint."
    },
    {
      "id": "start_here",
      "path": "START_HERE.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/START_HERE.md",
      "purpose": "Human-readable process overview."
    }
  ],
  "phase_files": [
    {
      "phase": "01_misamplace",
      "path": "agent/PHASE_01_MISAMPLACE.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/agent/PHASE_01_MISAMPLACE.md",
      "supporting_prompt": "prompts/01-systemprompt-entrevista-misamplace.md",
      "gate": "Misamplace collected or open gaps registered."
    },
    {
      "phase": "02_preparo",
      "path": "agent/PHASE_02_PREPARO.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/agent/PHASE_02_PREPARO.md",
      "supporting_skill": "skills/assistente-financeiro-meta/SKILL.md",
      "gate": "SQLite created, verify ok, snapshot and hash reported, SOUL.md and USER.md written."
    },
    {
      "phase": "03_operacao",
      "path": "agent/PHASE_03_OPERACAO.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/agent/PHASE_03_OPERACAO.md",
      "supporting_skill": "skills/assistente-financeiro-runtime/SKILL.md",
      "gate": "Runtime skill can read accounts, cards, invoices, loans and gaps."
    },
    {
      "phase": "04_crons",
      "path": "agent/PHASE_04_CRONS.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/agent/PHASE_04_CRONS.md",
      "supporting_prompt": "prompts/05-prompt-cron-html-e-cobranca.md",
      "gate": "Cron IDs listed and SQLite verified."
    },
    {
      "phase": "05_experimentacao",
      "path": "agent/PHASE_05_EXPERIMENTACAO.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/agent/PHASE_05_EXPERIMENTACAO.md",
      "supporting_prompts": [
        "prompts/06-experimentacao-html-situacao-atual.md",
        "prompts/07-experimentacao-registrar-comprovante.md",
        "prompts/08-experimentacao-recomendacao-proativa.md"
      ],
      "gate": "Three experiment tests completed or explicit blocker recorded."
    }
  ],
  "template_files": [
    "misamplace-template/README.md",
    "misamplace-template/dados_iniciais.json",
    "misamplace-template/contas.csv",
    "misamplace-template/cartoes.csv",
    "misamplace-template/emprestimos.csv",
    "misamplace-template/faturas.csv",
    "misamplace-template/despesas_recorrentes.csv",
    "misamplace-template/receitas.csv",
    "misamplace-template/gastos_iniciais.csv"
  ],
  "skill_files": [
    "skills/assistente-financeiro-meta/SKILL.md",
    "skills/assistente-financeiro-runtime/SKILL.md"
  ],
  "skill_support_files": [
    "skills/assistente-financeiro-meta/scripts/finance_db.py",
    "skills/assistente-financeiro-runtime/scripts/finance_db.py",
    "skills/assistente-financeiro-runtime/scripts/generate_weekly_html.py",
    "scripts/install_skills.py"
  ]
}
