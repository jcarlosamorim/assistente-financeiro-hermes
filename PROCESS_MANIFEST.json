    {
      "phase": "03_operacao",
      "path": "skills/assistente-financeiro-runtime/SKILL.md",
      "raw_url": "https://raw.githubusercontent.com/jcarlosamorim/assistente-financeiro-hermes/main/skills/assistente-financeiro-runtime/SKILL.md",
      "gate": "Runtime skill can read accounts, cards, invoices, loans and gaps."
    },
    {
